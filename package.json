{
  "name": "@vxe-ui/core",
  "version": "3.5.10",
  "description": "Vxe UI core library",
  "scripts": {
    "update": "npm install --legacy-peer-deps",
    "lint": "vue-cli-service lint",
    "lint:es": "eslint packages/**",
    "lint:ox": "oxfmt --check packages/**",
    "esfix": "eslint --fix packages/**",
    "oxfix": "oxfmt packages/** --write",
    "lib": "node scripts/build-modules.js",
    "clean:all": "node scripts/clean-all"
  },
  "files": [
    "lib",
    "es",
    "src",
    "types",
    "packages"
  ],
  "main": "lib/index.common.js",
  "module": "es/index.esm.js",
  "unpkg": "lib/index.umd.js",
  "jsdelivr": "lib/index.umd.js",
  "typings": "types/index.d.ts",
  "peerDependencies": {
    "vue": "^2.6.0"
  },
  "dependencies": {
    "dom-zindex": "^1.0.8",
    "xe-utils": "^4.1.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@types/node": "^20.12.12",
    "@types/resize-observer-browser": "^0.1.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-standard": "^6.1.0",
    "@vue/eslint-config-typescript": "^9.1.0",
    "core-js": "^3.8.3",
    "del": "^6.1.1",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-vue": "^8.0.3",
    "esbuild": "~0.28.2",
    "oxfmt": "~0.51.0",
    "postcss": "^8.4.38",
    "sass": "~1.101.7",
    "sass-loader": "^14.2.1",
    "sass-embedded": "^1.106.1",
    "rollup": "^4.53.3",
    "typescript": "~5.9.3",
    "vue-template-compiler": "2.6.14",
    "vue": "~2.6.14"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true,
    "es5-ext": true,
    "esbuild": true,
    "yorkie": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-extends/vxe-core.git"
  },
  "keywords": [
    "vxe",
    "vxe-core",
    "vxe-ui"
  ],
  "author": {
    "name": "Xu Liangzhan",
    "email": "xu_liangzhan@163.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/x-extends/vxe-core/issues"
  }
}
